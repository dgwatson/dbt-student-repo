# Copy to .env and fill in your own values. .env is gitignored.
SNOWFLAKE_ACCOUNT=XXXXXXX-YYYYYYYY
SNOWFLAKE_USER=dbt

# Absolute path (no ~ -- dbt does not expand it) to your private key file.
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/Keys/snowflake.p8

# Passphrase used when you generated the key. The DBT_ENV_SECRET_ prefix
# tells dbt to scrub the value out of its logs.
DBT_ENV_SECRET_SNOWFLAKE_PASSPHRASE=your-passphrase
